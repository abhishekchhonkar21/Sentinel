# Copy to .env and fill in values for local development.
# MongoDB Atlas connection string (primary datastore for deploys, events, reports, traces)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel?appName=Cluster0

# Groq API key (primary free LLM for Narrator and Critic agents)
GROQ_API_KEY=

# Gemini API key (fallback LLM when Groq rate-limits or is unavailable)
GEMINI_API_KEY=

# Neo4j (optional — leave empty to use in-memory NetworkX graph instead)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Service URLs (used by orchestrator and eval harness to call agent FastAPI services)
DETECTOR_URL=http://localhost:8001
INVESTIGATOR_URL=http://localhost:8002
HYPOTHESIS_RANKER_URL=http://localhost:8003
NARRATOR_URL=http://localhost:8004
CRITIC_URL=http://localhost:8005

# Toy system base URL (api-gateway entry point for load generator and fault injection)
TOY_SYSTEM_URL=http://localhost:8080

# Toy microservice URLs (docker-compose defaults; override for local non-docker dev)
ORDERS_SERVICE_URL=http://localhost:8081
PAYMENTS_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
EXTERNAL_PAYMENT_URL=http://localhost:8084

# Fault injection toggles (Week 2 harness will flip these)
FAULT_NULL_DEREF=false
FAULT_PAYMENT_TIMEOUT_MS=0
