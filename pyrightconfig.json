    "backend/apps/toy_system/external_payment_mock/src",
    "backend/services/detector/src",
    "backend/services/investigator/src",
    "backend/services/hypothesis_ranker/src",
    "backend/services/narrator/src",
    "backend/services/critic/src",
    "backend/services/orchestrator/src",
